# Copy this file to .env.local and fill in values. NEVER commit .env.local.
# The app runs fully on mock data when keys are absent (see PLAN.md section 4).

# NewsAPI (https://newsapi.org) — server-side only, consumed by /api/news
NEWS_API_KEY=

# TMDB (https://www.themoviedb.org/settings/api) — server-side only, consumed by /api/movies
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
